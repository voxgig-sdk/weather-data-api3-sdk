# Entity: forecast

main: kit: entity: forecast: {

  alias: field: {}

  fields: {
    current: {
      h: "Current"
      n: "current"
      r: false
      t: "`$OBJECT`"
    }
    current_units: {
      h: "Current Units"
      n: "current_units"
      r: false
      t: "`$OBJECT`"
    }
    daily: {
      h: "Daily"
      n: "daily"
      r: false
      t: "`$OBJECT`"
    }
    daily_units: {
      h: "Daily Units"
      n: "daily_units"
      r: false
      t: "`$OBJECT`"
    }
    elevation: {
      fo: "float"
      h: "Elevation"
      n: "elevation"
      r: false
      sh: "Elevation of the location in meters"
      t: "`$NUMBER`"
    }
    generationtime_ms: {
      fo: "float"
      h: "Generationtime Ms"
      n: "generationtime_ms"
      r: false
      sh: "Time taken to generate the response in milliseconds"
      t: "`$NUMBER`"
    }
    hourly: {
      h: "Hourly"
      n: "hourly"
      r: false
      t: "`$OBJECT`"
    }
    hourly_units: {
      h: "Hourly Units"
      n: "hourly_units"
      r: false
      t: "`$OBJECT`"
    }
    latitude: {
      fo: "float"
      h: "Latitude"
      n: "latitude"
